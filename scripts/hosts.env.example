# Teraguchi test-lab machine inventory. Copy to scripts/hosts.env and edit.
# scripts/hosts.env is gitignored (contains your host addresses).
#
# Format (space-separated specs; colon-separated fields):
#   name=ssh_target:role:python_cmd:repo_path
#
#   name        friendly label
#   ssh_target  user@host or ssh config alias
#   role        server | client | both
#   python_cmd  interpreter on that machine (python3 / python / "py -3")
#   repo_path   absolute path to the teraguchi checkout on that machine
#
# Windows note: OpenSSH Server's default shell may be PowerShell; we invoke the
# interpreter explicitly, so `python` (or `py -3`) works regardless.

MACHINES="\
mac=me@192.168.1.10:both:python3:/Users/me/teraguchi \
linux=me@192.168.1.11:both:python3:/home/me/teraguchi \
win=me@192.168.1.12:client:python:C:/Users/me/teraguchi"
