[Unit]
Description=Teraguchi Remote Desktop Server
# Depend on our own resilient headless Xorg (provides DISPLAY=:0), not the
# generic graphical.target — so we own the display lifecycle end to end.
After=network.target teraguchi-xorg.service
Requires=teraguchi-xorg.service

[Service]
Type=simple
# Change User to your actual username
User=CHANGEME
Environment=DISPLAY=:0
# Adjust the path to your Teraguchi installation
WorkingDirectory=/opt/teraguchi
ExecStart=/usr/bin/python3 -m server.main --port 443 --quic-port 444 --fps 30 --codec h264 --chroma yuv444
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
